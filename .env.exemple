NODE_ENV=development

PG_OCR_DB=ocr_db
PG_OCR_USER=ocr_user
PG_OCR_PASSWORD=ocr_password
PG_URL=postgresql://ocr_user:ocr_password@localhost:5435/ocr_db

BACKEND_PORT=4010

REDIS_OCR_PASSWORD=redis_password
REDIS_OCR_HOST=localhost
REDIS_OCR_PORT=6379

AMQP_URL=amqp://localhost:5672

S3_ACCESS_KEY=ocr_dev_access_key
S3_SECRET_KEY=ocr_dev_secret_key
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=ocr-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ALLOWED_HOSTS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

OPENAI_API_KEY=
